# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Cache: regenerated by scripts/prefetch.py
cache/
*.pkl
*.pt

# Build artifacts (regenerated by pdflatex)
paper/build/
paper/*.aux
paper/*.log
paper/*.out
paper/*.blg
paper/main.pdf

# LaTeX intermediates — main.bbl is intentionally tracked (Overleaf reads it);
# other LaTeX intermediates are not.
*.aux
*.out
*.bbl
*.blg
*.toc
*.synctex.gz

# Paper figures and the compiled submission PDF are tracked (needed by the
# ICASSP source package); other PDFs elsewhere in the repo are not.
*.pdf
!paper/*.pdf
!paper/figures/*.pdf
!figures/*.pdf
!results/*.pdf

# Logs
*.log
logs/

# OS / IDE
.DS_Store
.vscode/
.idea/
*.swp
*~